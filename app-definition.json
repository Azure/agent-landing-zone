{
  "$schema": "./contracts/app-definition-v1.schema.json",
  "schemaVersion": 1,
  "id": "agent-lz-default",
  "displayName": "Agent Landing Zone default application with optional ingestion and MCP",
  "components": [
    {
      "name": "mcp",
      "kind": "containerapp",
      "path": "mcp",
      "source": { "commit": "db9cc51fba28a520c678d56bd83344a4e4da71ed" },
      "profiles": ["model-user"],
      "egress": [
        {
          "fqdn": "login.microsoftonline.com",
          "protocol": "https",
          "port": 443,
          "purpose": "Validate Entra access tokens using tenant signing keys."
        }
      ],
      "ingress": "external"
    },
    {
      "name": "ui",
      "kind": "containerapp",
      "path": "ui",
      "source": { "commit": "3961224368685cd0e96966c18496adb8b6626987" },
      "profiles": ["blob-delegator", "retrieval-reader"],
      "egress": [],
      "ingress": "external"
    },
    {
      "name": "orchestrator",
      "kind": "containerapp",
      "path": "orchestrator",
      "source": { "commit": "e8a405fabe8a1185bcba2b0169eae0ae13743e66" },
      "profiles": ["model-user", "retrieval-reader"],
      "egress": [
        {
          "fqdn": "openaipublic.blob.core.windows.net",
          "protocol": "https",
          "port": 443,
          "purpose": "Download tiktoken encoding assets when the runtime cache is empty."
        }
      ],
      "ingress": "external"
    },
    {
      "name": "ingestion",
      "kind": "containerapp",
      "path": "ingestion",
      "source": { "commit": "d7f34eb040cc308ce18d0d95ee9c9cb0f07028b1" },
      "profiles": ["model-user", "conversation-store", "ingestion-writer"],
      "egress": [
        {
          "fqdn": "openaipublic.blob.core.windows.net",
          "protocol": "https",
          "port": 443,
          "purpose": "Download tiktoken encoding assets for chunking and token estimation when the runtime cache is empty."
        }
      ],
      "ingress": "external",
      "resources": { "cpu": 1.0, "memory": "3.0Gi" }
    }
  ]
}
