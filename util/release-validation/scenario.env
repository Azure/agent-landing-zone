# Standard release validation scenario (azd environment settings).
#
# Both providers (Bicep and Terraform) are validated with exactly these
# settings. A release is "validated" only when both pass this scenario. Change
# it through a reviewed pull request, because it defines what "validated" means.
#
# Run-specific values (subscription, region, resource group, hub VNet, the
# Terraform state backend and HOSTED_AGENT_RESOURCE_SCOPE) are set by
# run-validation.sh. Every other parameter keeps its main.parameters.json default.
ORCHESTRATION_HOST=hosted
APPLICATION_MODE=conversational
DEPLOY_INGESTION_CONTAINER_APP=false
BUILD_MODE=acr-task
DEPLOY_ACR_TASK_AGENT_POOL=true
NETWORK_ISOLATION=true
DEPLOY_JUMPBOX=false
DEPLOY_BASTION=false
